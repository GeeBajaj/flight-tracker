# Copy to .env and fill in ONE of these keys.

# AeroDataBox via RapidAPI (has a free tier): https://rapidapi.com/aedbx-aedbx/api/aerodatabox
AERODATABOX_KEY=

# FlightAware AeroAPI (paid, most precise gate/runway times): https://www.flightaware.com/aeroapi/
FLIGHTAWARE_KEY=

# Optional: force a provider when both keys are set (aerodatabox | flightaware)
# PROVIDER=aerodatabox

# Optional: server-side cache per flight, in seconds (saves API quota)
# CACHE_SECONDS=60
# PORT=3000
